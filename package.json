{
    "name": "fitness-studio-backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "build": "nest build",
        "stripe:listen": "stripe listen --forward-to http://localhost:3000/api/billing/webhook",
        "stripe:trigger:payment_failed": "stripe trigger invoice.payment_failed",
        "stripe:trigger:checkout_completed": "stripe trigger checkout.session.completed",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint '{src,tests}/**/*.ts' --fix",
        "seed": "ts-node --transpile-only prisma/seed.ts"
    },
    "prisma": {
        "seed": "ts-node --transpile-only prisma/seed.ts"
    },
    "dependencies": {
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.0.0",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/platform-ws": "^10.4.22",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^10.4.22",
        "@prisma/client": "^5.0.0",
        "@types/pdfkit": "^0.14.0",
        "bcrypt": "^5.1.0",
        "bullmq": "^5.76.8",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dotenv": "^16.0.0",
        "express-rate-limit": "^8.5.1",
        "firebase-admin": "^13.10.0",
        "ioredis": "^5.3.1",
        "mqtt": "^5.15.1",
        "nodemailer": "^8.0.7",
        "pdfkit": "^0.14.0",
        "prisma": "^5.0.0",
        "reflect-metadata": "^0.1.13",
        "stripe": "^12.0.0",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.4.22",
        "@types/bcrypt": "^5.0.0",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/node": "^20.0.0",
        "@types/nodemailer": "^8.0.0",
        "@types/supertest": "^2.0.12",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-import": "^2.30.0",
        "jest": "^29.7.0",
        "prettier": "^3.0.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.0.0",
        "ts-node": "^10.0.0",
        "typescript": "^5.5.0"
    }
