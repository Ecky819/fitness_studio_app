# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/fitness_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT (REQUIRED — no defaults, app will refuse to start if missing) ───────
JWT_ACCESS_SECRET=CHANGE_ME_min32chars_access_secret_here
JWT_REFRESH_SECRET=CHANGE_ME_min32chars_refresh_secret_here
ACCESS_TOKEN_SECRET=CHANGE_ME_min32chars_door_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=60s
ACCESS_TOKEN_VALIDATE_RATE_LIMIT=5
ACCESS_VALIDATE_WINDOW_SECONDS=60
JWT_CLOCK_TOLERANCE_SECONDS=5

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Stripe Price ID for hardware one-time purchase (set in Stripe Dashboard)
STRIPE_HARDWARE_PRICE_ID=price_REPLACE_ME

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=username@example.com
SMTP_PASS=REPLACE_ME
SMTP_FROM=noreply@gymOS.io

# ─── Storage ─────────────────────────────────────────────────────────────────
INVOICE_STORAGE_PATH=./storage/invoices

# ─── MQTT (Phase 4 — Device Telemetry) ───────────────────────────────────────
# External broker: Mosquitto, EMQX, HiveMQ, or cloud (AWS IoT, Azure IoT Hub)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=gym-os-backend

# ─── AI & Occupancy ───────────────────────────────────────────────────────────
# Max gym capacity for occupancy % calculation (tenant-level default)
DEFAULT_GYM_CAPACITY=50
# Estimated average visit duration in minutes (used for occupancy decay)
OCCUPANCY_VISIT_DURATION_MIN=90

# ─── Hardware Adapters (Phase 4) ─────────────────────────────────────────────
# Kisi
KISI_API_KEY=
KISI_WEBHOOK_SECRET=
# Brivo
BRIVO_CLIENT_ID=
BRIVO_CLIENT_SECRET=
BRIVO_API_KEY=
BRIVO_WEBHOOK_SECRET=
# Tapkey
TAPKEY_CLIENT_ID=
TAPKEY_CLIENT_SECRET=
TAPKEY_WEBHOOK_SECRET=
# AI Camera webhook
CAMERA_WEBHOOK_SECRET=

# ─── Observability (Phase 3) ──────────────────────────────────────────────────
# Sentry DSN — leave empty to disable error tracking
SENTRY_DSN=
# Structured log level: error | warn | info | debug | verbose
LOG_LEVEL=info
# Semantic version injected at build time (e.g. via CI: APP_VERSION=$(git describe --tags))
APP_VERSION=1.0.0
