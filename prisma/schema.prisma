generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AccessEventStatus {
  GRANTED
  DENIED
}

enum Role {
  USER
  TRAINER
  ADMIN
  SUPER_ADMIN // Platform-level role; not scoped to a tenant
}

enum TenantStatus {
  TRIAL      // 14-day trial, limited features
  ACTIVE     // Paid subscription
  SUSPENDED  // Payment failed or admin action
  CANCELLED  // Account closed
}

enum SaasPlan {
  STARTER    // 1 door, ≤100 members, basic analytics
  PRO        // 5 doors, ≤500 members, full analytics + white-label
  ENTERPRISE // Unlimited doors/members, Stripe Connect, API access
}

enum DeviceType {
  DOOR_CONTROLLER  // BLE/MQTT door controller (ESP32 or third-party)
  CAMERA           // AI occupancy camera (RTSP stream)
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant (the gym operator — top-level isolation boundary)
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id       String       @id @default(uuid())
  name     String                         // "Iron Palace GmbH"
  slug     String       @unique           // "iron-palace" → iron-palace.gymOS.io
  status   TenantStatus @default(TRIAL)
  plan     SaasPlan     @default(STARTER)

  // Stripe Connect — each tenant collects payments into their own account.
  // Platform earns via application_fee_amount on each transaction.
  stripeCustomerId  String?  // Platform-level Stripe customer
  stripeAccountId   String?  // Connected account (Express/Standard)

  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  config  TenantConfig?
  users   User[]
  plans   Plan[]
  devices Device[]

  @@index([slug])
}

// White-label configuration per tenant
model TenantConfig {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  gymName       String
  primaryColor  String  @default("#00D4FF") // hex
  accentColor   String  @default("#00FF88")
  logoUrl       String?
  faviconUrl    String?
  supportEmail  String?
  websiteUrl    String?
  timezone      String  @default("Europe/Berlin")

  // Feature flags as JSON — keyed by SaasFeature enum strings.
  // Example: {"ADVANCED_ANALYTICS": true, "MULTI_DOOR": false}
  features Json @default("{}")

  // Hardware adapter used for all doors in this tenant.
  // Override per device via Device.hardwareAdapter.
  // Values: "ble-secure" | "kisi" | "brivo" | "tapkey"
  hardwareAdapter String @default("ble-secure")

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Core domain models (all scoped to a Tenant)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  email        String
  password     String
  role         Role    @default(USER)
  isBlocked    Boolean @default(false)
  refreshToken String?
  fcmToken     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  accessGrants  AccessGrant[]
  payments      Payment[]
  accessEvents  AccessEvent[]
  invoices      Invoice[]
  aiInsights    AiInsight[]

  // Email is unique per tenant, not globally
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Plan {
  id            String  @id @default(uuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  name          String
  stripePriceId String  @unique
  amountCents   Int
  interval      String
  isActive      Boolean @default(true)

  subscriptions Subscription[]

  @@index([tenantId])
}

model Subscription {
  id               String             @id @default(uuid())
  stripeId         String             @unique
  user             User               @relation(fields: [userId], references: [id])
  userId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  planId           String
  status           SubscriptionStatus
  validUntil       DateTime
  currentPeriodEnd DateTime

  // Usage-based billing — Stripe subscription item ID for the metered access price.
  // Null = flat-rate subscription (default). Non-null = metered; usage reported monthly.
  stripeMeteredItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  invoices Invoice[]

  @@index([userId, status, validUntil])
}

model Payment {
  id              String       @id @default(uuid())
  stripePaymentId String?      @unique
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  amountCents     Int
  status          String
  createdAt       DateTime     @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

model AccessGrant {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  active     Boolean  @default(true)
  validUntil DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events AccessEvent[]

  @@index([userId, active, validUntil])
}

model AccessEvent {
  id            String            @id @default(uuid())
  accessGrant   AccessGrant       @relation(fields: [accessGrantId], references: [id])
  accessGrantId String
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  doorId        String?
  status        AccessEventStatus
  reason        String?
  createdAt     DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([doorId, createdAt])
  @@index([createdAt])
}

model Device {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  name            String
  doorId          String     @unique        // logical door/camera ID (e.g. "main_door", "cam_01")
  location        String
  type            DeviceType @default(DOOR_CONTROLLER)
  firmwareVersion String?
  isOnline        Boolean    @default(false)
  lastSeenAt      DateTime?

  // Provisioning — set on factory registration, cleared after first handshake
  provisioningToken String?  @unique
  provisionedAt     DateTime?

  // Per-device hardware adapter override (null = inherit from TenantConfig)
  hardwareAdapter String?

  // CAMERA type only — RTSP stream URL for the AI edge processing pipeline
  streamUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, type])
}

model Invoice {
  id             String       @id @default(uuid())
  invoiceNo      String       @unique
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String
  amountCents    Int
  currency       String
  pdfUrl         String
  createdAt      DateTime     @default(now())
}

model AccessAttempt {
  id        String   @id @default(uuid())
  tenantId  String?                   // populated async; null only in legacy/edge cases
  userId    String
  doorId    String
  grantId   String?
  success   Boolean
  reason    String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([doorId, createdAt])
}

model StripeWebhookEvent {
  id        String   @id @default(uuid())
  tenantId  String?                   // null = platform-level event
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — AI & Edge Layer
// ─────────────────────────────────────────────────────────────────────────────

// Point-in-time occupancy snapshots (archived every 15 min by background job).
// Redis holds the live counter; this table is the historical record for charts.
model OccupancySnapshot {
  id          String   @id @default(uuid())
  tenantId    String
  count       Int      // people currently estimated inside
  capacity    Int?     // max capacity configured for this tenant
  recordedAt  DateTime @default(now())

  @@index([tenantId, recordedAt])
}

// Cached churn-risk scores per user, recomputed on a schedule.
// score 0–100 | LOW <30 | MEDIUM 30–60 | HIGH >60
model AiInsight {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  churnScore     Int      // 0-100
  riskLevel      String   // LOW | MEDIUM | HIGH
  factors        Json     // array of { factor, weight } objects
  recommendation String?  // suggested action for the gym operator
  computedAt     DateTime @default(now())
  expiresAt      DateTime // recompute after this timestamp

  @@unique([tenantId, userId])
  @@index([tenantId, riskLevel])
  @@index([tenantId, churnScore])
}

// Time-based pricing rules defined per tenant.
// modifier: -0.20 = 20 % off-peak discount, +0.10 = 10 % peak surcharge.
model PricingRule {
  id          String   @id @default(uuid())
  tenantId    String
  name        String   // "Morning Off-Peak", "Evening Peak"
  daysOfWeek  Int[]    // 1=Mon … 7=Sun  (ISO weekday)
  timeFrom    String   // "06:00"
  timeTo      String   // "10:00"
  modifier    Float    // fractional price multiplier delta
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, isActive])
}
